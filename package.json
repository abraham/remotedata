{
  "name": "@abraham/remotedata",
  "version": "2.0.0",
  "description": "Lightweight TypeScript RemoteData implementation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/index.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:eslint": "eslint src",
    "lint": "npm run lint:eslint && npm run format:check",
    "pkg-ok": "pkg-ok",
    "prepare": "npm run build",
    "prepublishOnly": "npm run pkg-ok",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.lint.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abraham/remotedata.git"
  },
  "keywords": [
    "typescript",
    "remotedata",
    "lightweight",
    "micro",
    "library"
  ],
  "author": "Abraaham Williams <abraham@abrah.am>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abraham/remotedata/issues"
  },
  "homepage": "https://github.com/abraham/remotedata#readme",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.2.1",
    "pkg-ok": "^5.0.0",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
